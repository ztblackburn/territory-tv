
{
  "manifest_version": 3,
  "name": "Territory TV",
  "version": "1.0.0",
  "description": "Experience modern wrestling like a 1970s television broadcast.",
 "permissions": ["storage", "activeTab"],
 "icons": {
  "128": "icons/icon128.png"
},
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Territory TV",
    "default_icon": "icons/icon128.png"
  }
}
